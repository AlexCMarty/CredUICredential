<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "").Replace("-",""))</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- System.Management.Automation still advertises legacy win7/win8/win10 RIDs. The module
         is never published RID-specific, so the SDK complaint about them is noise. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management.Automation" Version="7.2.6" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CredUICredential.Tests" />
  </ItemGroup>

</Project>
